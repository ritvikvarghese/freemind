# Freemind local environment
# Copy this file to .env.local and fill in any values you want.
# Nothing here is required to run. The easiest path is to start the app and
# paste your key into the in-app panel ("Add your API key", top right), which
# stores it in your browser instead.

# Anthropic API key.
# WARNING: NEXT_PUBLIC_* vars are inlined into the client bundle. Only use this
# on a machine that is yours; never commit .env.local; never deploy.
# NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides.
# NEXT_PUBLIC_CLAUDE_MODEL=claude-sonnet-4-6        # Freeform research
# NEXT_PUBLIC_CLAUDE_DEEP_MODEL=claude-opus-4-7     # Deep research
# NEXT_PUBLIC_CLAUDE_CHAT_MODEL=claude-sonnet-4-6   # Canvas + document chat
# NEXT_PUBLIC_CLAUDE_OCR_MODEL=claude-sonnet-4-6    # Reading text from images
