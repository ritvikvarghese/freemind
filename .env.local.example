# Canvas AI — local environment
# Copy this file to .env.local and fill in any values you want.
# Nothing here is required to run; the in-app settings panel can store the key
# in localStorage instead.

# Anthropic API key (used by Milestone 3+).
# WARNING: NEXT_PUBLIC_* vars are inlined into the client bundle. Only use this
# on a machine that is yours; never commit .env.local; never deploy.
# NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default Claude model.
# NEXT_PUBLIC_CLAUDE_MODEL=claude-sonnet-4-6
